# Stockpot configuration. Copy to `.env` (docker compose reads it) or set the variables in your Portainer stack.
# Every variable is prefixed with STOCKPOT_ so Stockpot can share a stack with other services.
# Leave a variable unset to get the default shown here.

# Database. SQLite by default (a file in the Docker volume); any SQLAlchemy URL works, e.g. Postgres:
#   STOCKPOT_DATABASE_URL=postgresql+psycopg://stockpot:secret@db:5432/stockpot
# In Docker the default is sqlite:////data/stockpot.db (set in the image).
#STOCKPOT_DATABASE_URL=sqlite:///./data/stockpot.db

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
#STOCKPOT_LOG_LEVEL=INFO

# Bind address and port inside the container / process. The image sets the host to 0.0.0.0.
#STOCKPOT_HOST=127.0.0.1
#STOCKPOT_PORT=8000

# docker compose only: port published on the host.
#STOCKPOT_PUBLISHED_PORT=18010
