# Emile configuration. Copy to `.env` (docker compose reads it) or set the variables in your Portainer stack.
# Every variable is prefixed with EMILE_ so Emile can share a stack with other services.
# Leave a variable unset to get the default shown here.

# --- Database ---------------------------------------------------------------------------------------------------
# SQLite by default (a file in the Docker volume); any SQLAlchemy URL works, e.g. Postgres:
#   EMILE_DATABASE_URL=postgresql+psycopg://emile:secret@db:5432/emile
# In Docker the default is sqlite:////data/emile.db (set in the image).
#EMILE_DATABASE_URL=sqlite:///./data/emile.db
# Apply database migrations at startup. Set to false to run `emile db upgrade` yourself.
#EMILE_AUTO_MIGRATE=true

# --- Administration ---------------------------------------------------------------------------------------------
# Enables the /v1/admin API (create users, keys, households). At least 24 characters, e.g. `openssl rand -hex 32`.
# Unset: admin API disabled; use the CLI instead (`docker exec emile emile setup …`).
#EMILE_ADMIN_KEY=

# --- New households ---------------------------------------------------------------------------------------------
# Defaults for households created without these settings (each household can change them later).
#EMILE_DEFAULT_TIMEZONE=Europe/Paris
#EMILE_DEFAULT_LANGUAGE=fr
#EMILE_DEFAULT_CURRENCY=€

# --- Limits -----------------------------------------------------------------------------------------------------
# Items in one shopping list (60 fits one Telegram message with a button per item and per aisle).
#EMILE_MAX_LIST_ITEMS=60
# Entries in a household's stock.
#EMILE_MAX_STOCK_ITEMS=120
# Beyond this keeping time (days), a product is treated as keeping: no due date, no "still there?".
#EMILE_MAX_KEEPS_DAYS=60
# Days an unanswered "still there?" question waits before the entry leaves the stock.
#EMILE_ASK_GRACE_DAYS=3

# --- Server -----------------------------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
#EMILE_LOG_LEVEL=INFO
# Bind address and port inside the container / process. The image sets the host to 0.0.0.0.
#EMILE_HOST=127.0.0.1
#EMILE_PORT=8000
# docker compose only: port published on the host.
#EMILE_PUBLISHED_PORT=18010
